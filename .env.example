# ─────────────────────────────────────────────────────────────
#  Nusxa olish:  cp .env.example .env
#  (Vercel'da bu qiymatlar Project → Settings → Environment
#   Variables bo'limiga kiritiladi)
# ─────────────────────────────────────────────────────────────

# 1) Baza (Neon / Vercel Postgres / Supabase). SSL majburiy: ?sslmode=require
DATABASE_URL="postgresql://user:parol@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# 2) @BotFather bergan token (ko'rinishi: 123456789:AAH...)
TELEGRAM_BOT_TOKEN="123456789:AAHXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# 3) Admin panel paroli (bo'sh qolsa "admin123" ishlaydi — almashtiring!)
ADMIN_PASSWORD="kuchli-parol-yozing"

# 4) Webhook himoyasi (ixtiyoriy, lekin tavsiya etiladi).
#    Telegram har bir so'rovda shu qiymatni sarlavhada yuboradi,
#    /api/telegram/webhook uni tekshiradi. 1-256 belgi, A-Za-z0-9_- 
TELEGRAM_WEBHOOK_SECRET="agro_ferma_2026_secret"

# 5) Saytning ommaviy (public) manzili — webhook shu domenga o'rnatiladi.
#    Vercel'da: https://<loyiha-nomi>.vercel.app yoki o'z domeningiz.
SITE_URL="https://agrozbot.vercel.app"

# 6) Bot adminlari (ixtiyoriy). Telegram ID'lar vergul bilan.
#    Bo'sh bo'lsa — botga birinchi /start yozgan odam admin bo'ladi.
BOT_ADMIN_IDS=""