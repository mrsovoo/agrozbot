# Agroz AI (Python bot) kalitlari — nusxa oling: cp .env.example .env
# Bu BOT TypeScript agrozbot'nikidan AYRIDA (boshqa bot, masalan @agrozai_bot).

# @BotFather bergan token
BOT_TOKEN=123456789:REPLACE_ME_WITH_REAL_TOKEN

# groq.com dan bepul — Meta Llama (matnli savollar uchun)
GROQ_API_KEY=

# aistudio.google.com dan — Gemini (rasmli tashxis uchun)
GEMINI_API_KEY=

# Admin ID'lar (vergul bilan) — faqat ular uchun /post
ADMIN_IDS=

# Dataset fayli (ixtiyoriy; bo'sh qolsa agroz-core/messages.jsonl)
DATASET_PATH=
